# Neon PostgreSQL connection string
NEXT_PUBLIC_DRIZZLE_DB_URL=postgresql://username:password@host/database?sslmode=require

# Gemini API key
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Interview generation settings
NEXT_PUBLIC_INTERVIEW_QUESTION_COUNT=5
NEXT_PUBLIC_INFORMATION=Answer each question clearly and concisely.
NEXT_PUBLIC_QUESTION_NOTE=Take your time and answer each question thoughtfully.

# Clerk authentication keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here
